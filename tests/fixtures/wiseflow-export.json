s.s3.eu-central-1.amazonaws.com/learnosity/1.0/questionTypes/LongEssaySpellChecking/question.css","custom":{"formatting_options":[{"option":"appearance"},{"option":"formatting"},{"option":"coloring"},{"option":"alignment"},{"option":"lists"},{"option":"undo_redo"},{"option":"search_replace"},{"option":"clear_formatting"}],"languages":[{"iso":"en_GB"}]},"custom_type":"custom_type_long_essay_spell_check","height":550,"js":{"question":"https://wf-eu-central-1-stage-custom-questions.s3.eu-central-1.amazonaws.com/learnosity/1.0/questionTypes/LongEssaySpellChecking/question.js","scorer":"https://wf-eu-central-1-stage-custom-questions.s3.eu-central-1.amazonaws.com/learnosity/1.0/questionTypes/LongEssaySpellChecking/scorer.js"},"stimulus":"<div xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\">\n      <img src=\"https://api.stage.eu.wiseflow.io/link-signer/v1/static/wf-eu-central-1-stage-author-assets/images/ee716f5d-58ee-44aa-a555-ffdc07cbe7f2\" alt=\"Splejse reb (9%)&#10;&#10;Vi betragter en multi-mængde A af positive hele tal, som repræsenterer længder af reb vi har til rådighed.&#10;Vi kan nu splejse to reb sammen, og prisen for dette er summen af længderne.&#10;Altså kan vi vælge to tal x,y ∈ A.&#10;At splejse x og y betyder at vi opdaterer A til (A ∖ {x,y}) ∪ {x+y}.&#10;Omkostningen for dette er x+y.&#10;Bemærk at A er en multi-mængde, hvilket betyder at A kan indeholder flere elementer med samme værdi, og når vi fjerner x, så fjerner vi kun ét element med værdien x (og tilsvarende for y).&#10;Vi ønsker at splejse indtil A kun indeholder én værdi, og så den totale omkostning er mindst muligt.&#10;Vi repræsenterer A med et array.&#10;&#10;Eksempel:&#10;A=⟨3,1,7,2⟩.&#10;Vi splejser 1 og 2 med omkostning 3 og har A=⟨3,7,3⟩.&#10;Vi splejser 3 og 7 med omkostning 10 og har A=⟨3,10⟩.&#10;Vi splejser 3 og 10 med omkostning 13 og har A=⟨13⟩.&#10;Den totale omkostning ved denne splejsesekvens er 3+10+13=26.&#10;Bemærk at denne splejsesekvens ikke er optimal, da det er muligt at opnå en samlet omkostning på mindre end 26.&#10;&#10;a) Angiv den optimale splejsesekvens og den totale omkostning for A=⟨3,1,7,2⟩. Det er ikke nødvendigt at bevise at sekvensen er optimal.\" width=\"616\" height=\"331\"/>\n    </div><div xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\">\n      <img src=\"https://api.stage.eu.wiseflow.io/link-signer/v1/static/wf-eu-central-1-stage-author-assets/images/7209e93b-66fb-4db9-aea2-f4ecfb470fc4\" alt=\"b) Beskriv en effektiv algoritme som udregner den mindst mulige totale omkostning på at splejse indtil A kun indeholder én værdi.\" width=\"616\" height=\"45\"/>\n    </div><div xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\">\n      <img src=\"https://api.stage.eu.wiseflow.io/link-signer/v1/static/wf-eu-central-1-stage-author-assets/images/6f3732a1-095e-4f5f-a373-44cd163b7975\" alt=\"c) Forklar hvordan algoritmen fra del b), eller en forbedret algoritme, kan implementeres så køretiden er O(n log n), hvor n er størrelsen af A til at begynde med.\" width=\"616\" height=\"46\"/>\n    </div>","type":"custom","validation":{"max_score":1},"width":750},"metadata":null}],"features":[],"tags":[],"labels":[{"id":10528,"name":"9/30/2026_11:29:38AM","type":"personal"}]}],"metadata":{"author_version":"4.8.1","date_created":1791890557,"created_by":3000240308,"content":"item"}}