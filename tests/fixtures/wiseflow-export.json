,"penalty":1.333},"is_math":true},"metadata":{"name":"Multiple-choice (blok layout)"}}],"features":[],"tags":[],"labels":[{"id":10528,"name":"9/30/2026_11:29:38AM","type":"personal"}]},{"reference":"c814d9d9-a09b-4788-816e-232184696a7c","title":"Lange stier i træer (11%)","description":"","stimulus":" ","workflow":[],"metadata":[],"note":"","source":"","definition":{"widgets":[{"reference":"f027b988-a942-4b3b-9b5a-f5dc18370bda","widget_type":"response"}]},"status":"published","questions":[{"type":"custom","widget_type":"response","reference":"f027b988-a942-4b3b-9b5a-f5dc18370bda","data":{"css":"https://wf-eu-central-1-stage-custom-questions.s3.eu-central-1.amazonaws.com/learnosity/1.0/questionTypes/LongEssaySpellChecking/question.css","custom":{"formatting_options":[{"option":"appearance"},{"option":"formatting"},{"option":"coloring"},{"option":"alignment"},{"option":"lists"},{"option":"undo_redo"},{"option":"search_replace"},{"option":"clear_formatting"}],"languages":[[]],"show_current_word_count":"always","show_maximum_words":"always"},"custom_type":"custom_type_long_essay_spell_check","height":550,"js":{"question":"https://wf-eu-central-1-stage-custom-questions.s3.eu-central-1.amazonaws.com/learnosity/1.0/questionTypes/LongEssaySpellChecking/question.js","scorer":"https://wf-eu-central-1-stage-custom-questions.s3.eu-central-1.amazonaws.com/learnosity/1.0/questionTypes/LongEssaySpellChecking/scorer.js"},"stimulus":"<div xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\">\n      <img src=\"https://api.stage.eu.wiseflow.io/link-signer/v1/static/wf-eu-central-1-stage-author-assets/images/15e1c3a0-c2da-4fb4-ba8a-26e9329eb425\" alt=\"Lange stier i træer (11%)\n\nBetragt et binært træ T hvor hver knude har enten to eller ingen børn.\nLad roden være r og for enhver knude v, lad v.left og v.right være pointere til hhv. venstre og højre barn.\nHvis v ikke har nogen børn er v.left=v.right=NIL.\nI denne opgave ser vi på længder af stier i et træ -- f.eks. har træet nedenfor en sti af længde 3 fra roden r til bladet y og en sti af længde 5 fra bladet z til bladet w.\n\n[every node/.style=circle, draw,\nlevel distance=1.5cm,\nlevel 1/.style=sibling distance=4cm,\nlevel 2/.style=sibling distance=2cm,\nlevel 3/.style=sibling distance=1cm]\nr\nchild node s\nchild node u\n\nchild node v\nchild node y\nchild node z\n\nchild node t\nchild node w\nchild node x\n;\n\na) Vi ønsker at finde den maksimale længde af en sti fra r til et blad.\nLængden af en sti er antallet af kanter på stien.\nBeskriv en algoritme der løser problemet.\nInput til algoritmen er roden r.\nDu kan evt. skrive pseudokode, men det er også tilstrækkeligt med en klar og præcis beskrivelse i tekst.\nFor at få fuldt point skal køretiden være O(n), hvor n er antallet af knuder i T.\" width=\"616\" height=\"459\">\n    </div><div xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\">\n      <img src=\"https://api.stage.eu.wiseflow.io/link-signer/v1/static/wf-eu-central-1-stage-author-assets/images/054d86ff-2e0a-4b16-8d8f-f15723ef073a\" alt=\"b) Diameteren af T er den maksimale længde af en sti i T.\nBevis eller modbevis at en sti af maksimal længde altid starter og slutter i blade.\" width=\"616\" height=\"45\">\n    </div><div xmlns=\"http://www.imsglobal.org/xsd/imsqti_v2p1\">\n      <img src=\"https://api.stage.eu.wiseflow.io/link-signer/v1/static/wf-eu-central-1-stage-author-assets/images/81ef335a-6996-4bbf-93f3-b76ffa7daffa\" alt=\"c) Beskriv en algoritme der udregner diameteren af T og argumentér for dens korrekthed.\nInput til algoritmen er roden r.\nDu kan evt. skrive pseudokode, men det er også tilstrækkeligt med en klar og præcis beskrivelse i tekst.\nFor at få fuldt point skal køretiden være O(n), hvor n er antallet af knuder i T.\" width=\"616\" height=\"84\">\n    </div>","type":"custom","validation":{"max_score":1},"width":750,"version":"0.0.1"},"metadata":{"name":"Essay (med stavekontrol)"}}],"features":[],"tags":[],"labels":[{"id":10528,"name":"9/30/2026_11:29:38AM",